# ════════════════════════════════════════════════════
#  Hindi Auto-Blogger Agent — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub — it's in .gitignore
# ════════════════════════════════════════════════════

# ── Gemini AI (Required) ─────────────────────────────
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Platform: choose one ─────────────────────────────
# "wordpress" (recommended) or "blogger"
PLATFORM=wordpress

# ── WordPress Settings ───────────────────────────────
# Your WordPress site URL (no trailing slash)
WP_URL=https://yoursite.com

# WordPress admin username
WP_USERNAME=admin

# Application Password (WP Dashboard → Users → Profile → Application Passwords)
# Format: xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Blogger Settings (only if PLATFORM=blogger) ──────
# Numeric Blog ID from Blogger Dashboard → Settings
BLOG_ID=your_blogger_blog_id

# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Generated by running: python setup_auth.py  (one-time)
GOOGLE_REFRESH_TOKEN=your_refresh_token

# ── Agent Settings ────────────────────────────────────
# Hours between posts (0.5 = 30 min for testing)
INTERVAL_HOURS=6

# Set to false to save drafts locally without publishing
AUTO_PUBLISH=true

# Local folder for draft JSON files
DRAFTS_DIR=drafts
